<?xml version="1.0" encoding="utf-8" ?>
<Window
    x:Class="Orion.App.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:models="using:Orion.Core.Models"
    Title="Orion Store for PC"
    mc:Ignorable="d">

    <Window.SystemBackdrop>
        <MicaBackdrop />
    </Window.SystemBackdrop>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Custom App TitleBar with Device Switcher -->
        <Border x:Name="AppTitleBar" Background="Transparent" Height="48" Padding="16,0">
            <Grid ColumnDefinitions="Auto,*,Auto" VerticalAlignment="Center">
                
                <!-- Logo & Brand -->
                <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                    <Image Source="ms-appx:///Assets/Square44x44Logo.scale-200.png" Width="22" Height="22" VerticalAlignment="Center" />
                    <TextBlock Text="Orion Store" FontWeight="SemiBold" FontSize="14" VerticalAlignment="Center" />
                </StackPanel>

                <!-- Center: Device Switcher (CORE BEHAVIOR RULE) -->
                <StackPanel Grid.Column="1" HorizontalAlignment="Center" Orientation="Horizontal" Spacing="8">
                    <TextBlock Text="Target Device:" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" VerticalAlignment="Center" Margin="0,0,4,0" />
                    <ComboBox x:Name="DeviceSwitcherBox" SelectionChanged="OnDeviceSelectionChanged" SelectedIndex="0" Width="140" FontSize="12">
                        <ComboBoxItem Content="Windows" Tag="Windows" />
                        <ComboBoxItem Content="Android" Tag="Android" />
                        <ComboBoxItem Content="Linux" Tag="Linux" />
                        <ComboBoxItem Content="macOS" Tag="MacOS" />
                        <ComboBoxItem Content="All Platforms" Tag="All" />
                    </ComboBox>
                </StackPanel>

                <!-- Right: GitHub Account button (before caption buttons) -->
                <StackPanel Grid.Column="2" HorizontalAlignment="Right" Orientation="Horizontal" Spacing="8" Margin="0,0,140,0" VerticalAlignment="Center">
                    <!-- Not Authenticated Button -->
                    <Button Style="{ThemeResource SubtleButtonStyle}" 
                            x:Name="GitHubSignInButton"
                            Click="OnGitHubSignInClicked"
                            Padding="8,4" CornerRadius="6">
                        <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                            <FontIcon Glyph="&#xE8A7;" FontSize="14" />
                            <TextBlock Text="Sign in" FontSize="12" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>

                    <!-- Authenticated User Pill with MenuFlyout -->
                    <Button Style="{ThemeResource SubtleButtonStyle}"
                            x:Name="GitHubProfileButton"
                            Visibility="Collapsed"
                            Padding="6,3" CornerRadius="16">
                        <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                            <Border Width="22" Height="22" CornerRadius="11" Background="{ThemeResource LayerFillColorDefaultBrush}">
                                <Image x:Name="GitHubAvatarImage" Stretch="UniformToFill" />
                            </Border>
                            <TextBlock x:Name="GitHubLoginTextBlock" FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center" />
                        </StackPanel>

                        <Button.Flyout>
                            <MenuFlyout>
                                <MenuFlyoutItem Text="View Profile on GitHub" Click="OnOpenGitHubProfileClicked" />
                                <MenuFlyoutItem Text="Account &amp; API Settings" Click="OnOpenSettingsClicked" />
                                <MenuFlyoutSeparator />
                                <MenuFlyoutItem Text="Sign Out" Click="OnGitHubSignOutClicked" />
                            </MenuFlyout>
                        </Button.Flyout>
                    </Button>
                </StackPanel>

            </Grid>
        </Border>

        <!-- Main Navigation View -->
        <NavigationView
            x:Name="RootNavView"
            Grid.Row="1"
            PaneDisplayMode="Left"
            IsBackButtonVisible="Collapsed"
            SelectionChanged="OnNavSelectionChanged">
            
            <NavigationView.MenuItems>
                <NavigationViewItem Content="Store" Tag="Home">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE719;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem Content="Search" Tag="Search">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE721;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem Content="My Apps" Tag="MyApps">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE74C;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem Content="Downloads" Tag="Downloads">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE896;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
            </NavigationView.MenuItems>

            <NavigationView.FooterMenuItems>
                <NavigationViewItem Content="About" Tag="About">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE897;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
            </NavigationView.FooterMenuItems>

            <Frame x:Name="ContentFrame" />
        </NavigationView>

    </Grid>
</Window>
