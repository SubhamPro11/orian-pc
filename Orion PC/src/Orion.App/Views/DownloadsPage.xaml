<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="Orion.App.Views.DownloadsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:ps="using:Orion.Platform.Windows.Services"
    xmlns:vm="using:Orion.App.ViewModels"
    mc:Ignorable="d">

    <Grid RowDefinitions="Auto,*" Padding="24" RowSpacing="16">
        <StackPanel Spacing="4">
            <TextBlock Text="Downloads Queue" Style="{ThemeResource TitleTextBlockStyle}" />
            <TextBlock Text="Manage active and completed downloads." Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
        </StackPanel>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <ListView ItemsSource="{x:Bind ViewModel.DownloadQueue, Mode=OneWay}" SelectionMode="None">
                <ListView.ItemTemplate>
                    <DataTemplate x:DataType="ps:DownloadItem">
                        <Border CornerRadius="8" Padding="16" Margin="0,0,0,12" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1">
                            <StackPanel Spacing="8">
                                <Grid ColumnDefinitions="*,Auto">
                                    <StackPanel Spacing="2">
                                        <TextBlock Text="{x:Bind AppName}" FontWeight="SemiBold" FontSize="15" />
                                        <TextBlock Text="{x:Bind Version}" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                    </StackPanel>
                                    <TextBlock Grid.Column="1" Text="{x:Bind Status}" FontWeight="SemiBold" VerticalAlignment="Center" />
                                </Grid>

                                <ProgressBar Value="{x:Bind ProgressPercent}" Maximum="100" />

                                <Grid ColumnDefinitions="*,Auto">
                                    <TextBlock Text="{x:Bind LocalFilePath}" FontSize="11" Foreground="{ThemeResource TextFillColorTertiaryBrush}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                                    <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8">
                                        <Button Content="Pause" Command="{Binding ElementName=RootPage, Path=ViewModel.PauseCommand}" CommandParameter="{x:Bind Id}" />
                                        <Button Content="Resume" Command="{Binding ElementName=RootPage, Path=ViewModel.ResumeCommand}" CommandParameter="{x:Bind Id}" />
                                        <Button Content="Cancel" Style="{ThemeResource SubtleButtonStyle}" Command="{Binding ElementName=RootPage, Path=ViewModel.CancelCommand}" CommandParameter="{x:Bind Id}" />
                                    </StackPanel>
                                </Grid>
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>
        </ScrollViewer>
    </Grid>
</Page>

