<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="Orion.App.Views.SearchPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:models="using:Orion.Core.Models"
    xmlns:vm="using:Orion.App.ViewModels"
    mc:Ignorable="d">

    <Grid RowDefinitions="Auto,*" Padding="24" RowSpacing="16">

        <!-- Controls Header -->
        <StackPanel Spacing="12">
            <TextBlock Text="Search &amp; Categories" Style="{ThemeResource TitleTextBlockStyle}" />

            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                <AutoSuggestBox QueryIcon="Find" PlaceholderText="Search apps by title, author, description, or id..." Text="{x:Bind ViewModel.Query, Mode=TwoWay}" />
                <ComboBox Grid.Column="1" Header="Category" ItemsSource="{x:Bind ViewModel.Categories}" SelectedItem="{x:Bind ViewModel.SelectedCategory, Mode=TwoWay}" Width="160" />
            </Grid>
        </StackPanel>

        <!-- Results Grid -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <GridView ItemsSource="{x:Bind ViewModel.Results, Mode=OneWay}" SelectionMode="None" IsItemClickEnabled="True" ItemClick="OnAppItemClicked">
                <GridView.ItemTemplate>
                    <DataTemplate x:DataType="models:AppItem">
                        <Border Width="280" Height="96" CornerRadius="8" Padding="12" Margin="0,0,12,12" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1">
                            <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12">
                                <Border Width="48" Height="48" CornerRadius="8" Background="{ThemeResource LayerFillColorDefaultBrush}">
                                    <Image Source="{x:Bind SafeIcon}" Stretch="UniformToFill" />
                                </Border>
                                <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                                    <TextBlock Text="{x:Bind Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" MaxLines="1" />
                                    <TextBlock Text="{x:Bind Category}" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                    <StackPanel Orientation="Horizontal" Spacing="6">
                                        <Border Background="{ThemeResource LayerFillColorDefaultBrush}" CornerRadius="4" Padding="4,1">
                                            <TextBlock Text="{x:Bind Platform}" FontSize="10" />
                                        </Border>
                                        <TextBlock Text="{x:Bind Version}" FontSize="11" Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                                    </StackPanel>
                                </StackPanel>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </GridView.ItemTemplate>
            </GridView>
        </ScrollViewer>

    </Grid>
</Page>

