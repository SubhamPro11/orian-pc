<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="Orion.App.Views.SettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:vm="using:Orion.App.ViewModels"
    mc:Ignorable="d">

    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="24">
        <StackPanel Spacing="24" MaxWidth="700" HorizontalAlignment="Left">
            <TextBlock Text="Settings" Style="{ThemeResource TitleTextBlockStyle}" />

            <!-- Appearance Section -->
            <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="8" Padding="16">
                <StackPanel Spacing="16">
                    <TextBlock Text="Appearance" Style="{ThemeResource SubtitleTextBlockStyle}" FontSize="16" />
                    <ComboBox Header="App Theme" SelectedValue="{x:Bind ViewModel.SelectedTheme, Mode=TwoWay}" Width="200">
                        <x:String>Default</x:String>
                        <x:String>Light</x:String>
                        <x:String>Dark</x:String>
                    </ComboBox>
                    <ToggleSwitch Header="Windows 11 Mica Backdrop" IsOn="{x:Bind ViewModel.UseMicaBackdrop, Mode=TwoWay}" />
                </StackPanel>
            </Border>

            <!-- GitHub Account Section -->
            <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="8" Padding="16">
                <StackPanel Spacing="16">
                    <TextBlock Text="GitHub Account Integration" Style="{ThemeResource SubtitleTextBlockStyle}" FontSize="16" />

                    <!-- Authenticated User Card -->
                    <StackPanel Spacing="16" Visibility="{x:Bind ViewModel.IsGitHubAuthenticated, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}">
                        <Grid ColumnDefinitions="Auto,*">
                            <Border Grid.Column="0" Width="56" Height="56" CornerRadius="28" Background="{ThemeResource LayerFillColorDefaultBrush}" Margin="0,0,16,0">
                                <Image Source="{x:Bind ViewModel.GitHubUserAvatarUrl, Mode=OneWay}" Stretch="UniformToFill" />
                            </Border>

                            <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                                <TextBlock Text="{x:Bind ViewModel.GitHubUserDisplayName, Mode=OneWay}" FontWeight="SemiBold" FontSize="16" />
                                <TextBlock Text="{x:Bind ViewModel.GitHubUserLogin, Mode=OneWay}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                <TextBlock Text="{x:Bind ViewModel.GitHubUserBio, Mode=OneWay}" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" Visibility="{x:Bind ViewModel.GitHubUserBio, Mode=OneWay, Converter={StaticResource StringVisibilityConverter}}" />
                            </StackPanel>
                        </Grid>

                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <Border Background="{ThemeResource LayerFillColorDefaultBrush}" CornerRadius="4" Padding="8,4">
                                <TextBlock Text="{x:Bind ViewModel.GitHubUserReposCount, Mode=OneWay}" FontSize="11" />
                            </Border>
                            <Border Background="{ThemeResource LayerFillColorDefaultBrush}" CornerRadius="4" Padding="8,4">
                                <TextBlock Text="5,000 API requests/hr enabled" FontSize="11" Foreground="{ThemeResource SystemAccentColor}" FontWeight="SemiBold" />
                            </Border>
                        </StackPanel>

                        <StackPanel Orientation="Horizontal" Spacing="12">
                            <Button Content="View GitHub Profile" Style="{ThemeResource DefaultButtonStyle}" Command="{x:Bind ViewModel.OpenGitHubProfileCommand}" />
                            <Button Content="Sign Out" Style="{ThemeResource DefaultButtonStyle}" Command="{x:Bind ViewModel.LogoutGitHubCommand}" />
                        </StackPanel>
                    </StackPanel>

                    <!-- Not Authenticated State -->
                    <StackPanel Spacing="12" Visibility="{x:Bind ViewModel.IsGitHubAuthenticated, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}, ConverterParameter=Inverse}">
                        <TextBlock Text="Connect your GitHub account to enable authenticated API access (5,000 requests/hour), download releases, and avoid rate limits." TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />

                        <StackPanel Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
                            <Button Style="{ThemeResource AccentButtonStyle}" Command="{x:Bind ViewModel.LoginGitHubBrowserCommand}" IsEnabled="{x:Bind ViewModel.IsGitHubBusy, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}, ConverterParameter=Inverse}">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <FontIcon Glyph="&#xE8A7;" />
                                    <TextBlock Text="Sign in with GitHub" />
                                </StackPanel>
                            </Button>
                            <ProgressRing IsActive="{x:Bind ViewModel.IsGitHubBusy, Mode=OneWay}" Width="20" Height="20" Visibility="{x:Bind ViewModel.IsGitHubBusy, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}" />
                        </StackPanel>

                        <!-- Optional: Token Alternative Expander -->
                        <Expander Header="Alternative: Sign in with Personal Access Token" HorizontalAlignment="Stretch" Margin="0,8,0,0">
                            <StackPanel Spacing="12" Padding="0,8">
                                <TextBlock Text="If your browser cannot reach loopback, you can paste a GitHub Personal Access Token (PAT) with read:user scope:" Foreground="{ThemeResource TextFillColorSecondaryBrush}" FontSize="12" />
                                <PasswordBox Password="{x:Bind ViewModel.ManualToken, Mode=TwoWay}" PlaceholderText="ghp_... or ghu_..." />
                                <Button Content="Connect with Token" Style="{ThemeResource DefaultButtonStyle}" Command="{x:Bind ViewModel.LoginWithTokenCommand}" />
                            </StackPanel>
                        </Expander>
                    </StackPanel>

                    <!-- Auth Status Message -->
                    <TextBlock Text="{x:Bind ViewModel.GitHubAuthMessage, Mode=OneWay}" Foreground="{ThemeResource SystemAccentColor}" FontWeight="SemiBold" Visibility="{x:Bind ViewModel.GitHubAuthMessage, Mode=OneWay, Converter={StaticResource StringVisibilityConverter}}" />
                </StackPanel>
            </Border>

            <!-- VirusTotal Security Section -->
            <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="8" Padding="16">
                <StackPanel Spacing="16">
                    <TextBlock Text="VirusTotal Security Integration (Optional)" Style="{ThemeResource SubtitleTextBlockStyle}" FontSize="16" />
                    <TextBlock Text="Add your own VirusTotal API key to inspect installer packages prior to execution. Your key is securely stored inside Windows Credential Locker using DPAPI encryption." TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    
                    <PasswordBox Header="VirusTotal API Key" Password="{x:Bind ViewModel.VirusTotalApiKey, Mode=TwoWay}" PlaceholderText="Enter API Key" />
                    
                    <Button Content="Save API Key" Style="{ThemeResource AccentButtonStyle}" Command="{x:Bind ViewModel.SaveApiKeyCommand}" />
                    <TextBlock Text="{x:Bind ViewModel.SaveMessage, Mode=OneWay}" Foreground="{ThemeResource SystemAccentColor}" FontWeight="SemiBold" Visibility="{x:Bind ViewModel.SaveMessage, Mode=OneWay, Converter={StaticResource StringVisibilityConverter}}" />
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</Page>

