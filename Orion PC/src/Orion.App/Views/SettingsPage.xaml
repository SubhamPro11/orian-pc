<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="Orion.App.Views.SettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:vm="using:Orion.App.ViewModels"
    mc:Ignorable="d">

    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="24">
        <StackPanel Spacing="24" MaxWidth="700" HorizontalAlignment="Left">
            <TextBlock Text="Settings" Style="{ThemeResource TitleTextBlockStyle}" />

            <!-- Appearance Section -->
            <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="8" Padding="16">
                <StackPanel Spacing="16">
                    <TextBlock Text="Appearance" Style="{ThemeResource SubtitleTextBlockStyle}" FontSize="16" />
                    <ComboBox Header="App Theme" SelectedValue="{x:Bind ViewModel.SelectedTheme, Mode=TwoWay}" Width="200">
                        <x:String>Default</x:String>
                        <x:String>Light</x:String>
                        <x:String>Dark</x:String>
                    </ComboBox>
                    <ToggleSwitch Header="Windows 11 Mica Backdrop" IsOn="{x:Bind ViewModel.UseMicaBackdrop, Mode=TwoWay}" />
                </StackPanel>
            </Border>

            <!-- VirusTotal Security Section -->
            <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="8" Padding="16">
                <StackPanel Spacing="16">
                    <TextBlock Text="VirusTotal Security Integration (Optional)" Style="{ThemeResource SubtitleTextBlockStyle}" FontSize="16" />
                    <TextBlock Text="Add your own VirusTotal API key to inspect installer packages prior to execution. Your key is securely stored inside Windows Credential Locker using DPAPI encryption." TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    
                    <PasswordBox Header="VirusTotal API Key" Password="{x:Bind ViewModel.VirusTotalApiKey, Mode=TwoWay}" PlaceholderText="Enter API Key" />
                    
                    <Button Content="Save API Key" Style="{ThemeResource AccentButtonStyle}" Command="{x:Bind ViewModel.SaveApiKeyCommand}" />
                    <TextBlock Text="{x:Bind ViewModel.SaveMessage, Mode=OneWay}" Foreground="{ThemeResource SystemAccentColor}" FontWeight="SemiBold" Visibility="{x:Bind ViewModel.SaveMessage, Mode=OneWay, Converter={StaticResource StringVisibilityConverter}}" />
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</Page>

