<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="Orion.App.Views.AboutPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:vm="using:Orion.App.ViewModels"
    mc:Ignorable="d">

    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="24">
        <StackPanel Spacing="24" MaxWidth="700" HorizontalAlignment="Left">
            <StackPanel Orientation="Horizontal" Spacing="16" VerticalAlignment="Center">
                <Border Width="56" Height="56" CornerRadius="12" Background="{ThemeResource LayerFillColorDefaultBrush}">
                    <Image Source="ms-appx:///Assets/Square150x150Logo.scale-200.png" Stretch="UniformToFill" />
                </Border>
                <StackPanel Spacing="4" VerticalAlignment="Center">
                    <TextBlock Text="About Orion Store for PC" Style="{ThemeResource TitleTextBlockStyle}" />
                    <TextBlock Text="{x:Bind ViewModel.Version}" Style="{ThemeResource SubtitleTextBlockStyle}" Foreground="{ThemeResource SystemAccentColor}" />
                </StackPanel>
            </StackPanel>

            <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="8" Padding="16">
                <StackPanel Spacing="12">
                    <TextBlock Text="Philosophy &amp; Transparency" FontWeight="SemiBold" FontSize="16" />
                    <TextBlock Text="{x:Bind ViewModel.Description}" TextWrapping="Wrap" LineHeight="22" />
                    <TextBlock Text="• Zero Analytics &amp; Zero Tracking" />
                    <TextBlock Text="• Public JSON Catalog &amp; Direct Multi-Source Release Mirrors" />
                    <TextBlock Text="• Built natively for Windows with WinUI 3 and .NET 8" />
                </StackPanel>
            </Border>

            <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="8" Padding="16">
                <StackPanel Spacing="12">
                    <TextBlock Text="License &amp; Credits" FontWeight="SemiBold" FontSize="16" />
                    <TextBlock Text="{x:Bind ViewModel.License}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    <TextBlock Text="Original Orion Store created by RookieZ and open-source contributors." />
                    <TextBlock Text="Licensed under GNU General Public License v3.0 (GPL-3.0)." />
                </StackPanel>
            </Border>

            <StackPanel Orientation="Horizontal" Spacing="12">
                <Button Style="{ThemeResource AccentButtonStyle}" Command="{x:Bind ViewModel.OpenGithubCommand}">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <FontIcon Glyph="&#xE8A7;" />
                        <TextBlock Text="GitHub Repository" />
                    </StackPanel>
                </Button>
                <Button Style="{ThemeResource DefaultButtonStyle}" Command="{x:Bind ViewModel.OpenDiscordCommand}">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <FontIcon Glyph="&#xE8BD;" />
                        <TextBlock Text="Discord Community" />
                    </StackPanel>
                </Button>
                <Button Style="{ThemeResource DefaultButtonStyle}" Command="{x:Bind ViewModel.OpenDonationCommand}">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <FontIcon Glyph="&#xEB51;" Foreground="#f43f5e" />
                        <TextBlock Text="Support Developer" />
                    </StackPanel>
                </Button>
            </StackPanel>
        </StackPanel>
    </ScrollViewer>
</Page>

