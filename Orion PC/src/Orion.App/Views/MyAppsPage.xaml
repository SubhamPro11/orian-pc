<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="Orion.App.Views.MyAppsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:vm="using:Orion.App.ViewModels"
    mc:Ignorable="d">

    <Grid RowDefinitions="Auto,*" Padding="24" RowSpacing="16">
        <!-- Header -->
        <StackPanel Spacing="8">
            <TextBlock Text="My Apps" Style="{ThemeResource TitleTextBlockStyle}" />
            <StackPanel Orientation="Horizontal" Spacing="16">
                <TextBlock Text="{x:Bind ViewModel.InstalledCount, Mode=OneWay}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                <TextBlock Text="installed apps" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                <Border Background="{ThemeResource SystemAccentColor}" CornerRadius="4" Padding="6,1" Visibility="{x:Bind ViewModel.UpdatesCount, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}">
                    <TextBlock Text="Updates Available" Foreground="White" FontSize="11" />
                </Border>
            </StackPanel>
        </StackPanel>

        <!-- List -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <ListView ItemsSource="{x:Bind ViewModel.InstalledApps, Mode=OneWay}" SelectionMode="None">
                <ListView.ItemTemplate>
                    <DataTemplate x:DataType="vm:MyAppItemModel">
                        <Border CornerRadius="8" Padding="12" Margin="0,0,0,8" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1">
                            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="16" VerticalAlignment="Center">
                                <StackPanel Spacing="2">
                                    <TextBlock Text="{x:Bind InstalledInfo.DisplayName}" FontWeight="SemiBold" FontSize="15" />
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <TextBlock Text="{x:Bind InstalledInfo.DisplayVersion}" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                        <TextBlock Text="•" FontSize="12" Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                                        <TextBlock Text="{x:Bind InstalledInfo.Source}" FontSize="12" Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                                    </StackPanel>
                                </StackPanel>

                                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8">
                                    <Button Content="Details" Click="OnOpenDetailsClicked" Tag="{x:Bind}" />
                                    <Button Content="Uninstall" Style="{ThemeResource SubtleButtonStyle}" Click="OnUninstallClicked" Tag="{x:Bind}" />
                                </StackPanel>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>
        </ScrollViewer>
    </Grid>
</Page>

